# Local desktop research runtime only. Never point this at a browser- or
# Vercel-accessible filesystem path.
ASHANTE_SQLITE_PATH=.local/ashante.sqlite

# Server-side promoted-projection integration. Values are optional until the
# Firestore packet is opened; secrets belong in local/Vercel env storage only.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# The only Firebase value currently permitted in a browser bundle.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
